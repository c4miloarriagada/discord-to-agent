DISCORD_BOT_TOKEN=your_bot_token_here
ALLOWED_CHANNEL_IDS=123456789,987654321
ALLOWED_USER_IDS=
WORKING_DIR=/home/user/projects
AGENT_TYPE=kimi
KIMI_COMMAND=kimi
KIMI_AUTO_APPROVE_FLAG=--yolo
KIMI_SESSIONS_DIR=~/.kimi-code/sessions
KIMI_CONTEXT_WINDOW=1048576
PROMPT_TIMEOUT=300
RATE_LIMIT_SECONDS=10
LOG_LEVEL=INFO

# PR comment notifications (optional). If GITHUB_TOKEN is empty, the bot
# falls back to the token in ~/.kimi-code/mcp.json (the GitHub MCP server).
GITHUB_TOKEN=
GITHUB_REPOS=owner/repo,owner/repo2
GITHUB_USERNAME=
GITHUB_POLL_INTERVAL=60
NOTIFY_CHANNEL_ID=
