DISCORD_BOT_TOKEN=your_bot_token_here
ALLOWED_CHANNEL_IDS=123456789,987654321
ALLOWED_USER_IDS=
WORKING_DIR=/home/user/projects
AGENT_TYPE=kimi
# Agent config home dir (mounted into the container). Per agent: .kimi-code, .claude...
AGENT_HOME_DIR=.kimi-code
KIMI_COMMAND=kimi
KIMI_AUTO_APPROVE_FLAG=--yolo
KIMI_SESSIONS_DIR=~/.kimi-code/sessions
KIMI_CONTEXT_WINDOW=1048576
PROMPT_TIMEOUT=300
RATE_LIMIT_SECONDS=10
LOG_LEVEL=INFO
# Where per-user agent sessions persist (keeps agent context across restarts).
SESSION_STORE_PATH=~/.kimi-code/bot_sessions.json

# PR comment notifications (optional). If GITHUB_TOKEN is empty, the bot
# falls back to GITHUB_PERSONAL_ACCESS_TOKEN and then ~/.kimi-code/mcp.json.
# GITHUB_PERSONAL_ACCESS_TOKEN is also used by the github-mcp-server in Docker.
GITHUB_TOKEN=
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_REPOS=owner/repo,owner/repo2
GITHUB_USERNAME=
GITHUB_POLL_INTERVAL=60
NOTIFY_CHANNEL_ID=
